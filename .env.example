# Copy to .env and adjust. Never commit .env.

# Chat model provider: ollama (local, free) or anthropic (Claude, needs an API key)
RAG_PROVIDER=ollama
# Must support tool calling. Ollama default: llama3.1:8b. Claude default: claude-opus-5-5
RAG_MODEL=llama3.1:8b
# Ollama context window in tokens. Raise it for long conversations if your GPU has room.
OLLAMA_NUM_CTX=16384
# Thinking models only (e.g. qwen3): true | false | low | medium | high. Leave empty for llama3.1.
OLLAMA_REASONING=

# Only for RAG_PROVIDER=anthropic
ANTHROPIC_API_KEY=
RAG_EFFORT=medium

# Vector index for this app (fill it with `docagent ingest <folder>`)
CHROMA_DIR=.chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5

# Chat memory (LangGraph SQLite checkpointer)
MEMORY_DB=.memory/checkpoints.sqlite
